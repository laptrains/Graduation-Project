# 统一换行符：仓库内按 LF 存储，避免 Windows 开发 / Linux 部署混用时产生整文件 diff
* text=auto

# ---------- 源码与配置：强制 LF ----------
*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.ts       text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.md       text eol=lf

# Shell 脚本必须是 LF，否则在 Linux / WSL / macOS 上会因 \r 报解释器错误
*.sh       text eol=lf

# Windows 批处理保持 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---------- 二进制：不做任何转换 ----------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.exe      binary
*.dll      binary
