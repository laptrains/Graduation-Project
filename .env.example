# 复制为 .env 后填写真实值：cp .env.example .env
# start.sh 会直接 source 本文件，因此请按 shell 语法书写：等号两侧不要有空格，值建议加引号
# .env 含密钥，请勿提交到仓库

# ---------- 对话模型（必填）----------
# 后端 model.go 读取，用于聊天与 MCP 模式；需支持 Tool Calling，否则只能纯对话
export OPENAI_API_KEY="sk-your-key"
export OPENAI_MODEL_NAME="deepseek-chat"
export OPENAI_BASE_URL="https://api.deepseek.com/v1"

# ---------- 摘要模型（可选）----------
# 仅用于会话滚动摘要与长期记忆提取；不配置则服务照常启动，退化为按消息条数上限兜底
export DEEPSEEK_API_KEY="sk-your-key"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
export DEEPSEEK_MODEL_NAME="deepseek-chat"

# ---------- MCP Server（可选）----------
# 后端作为 MCP Client 连接该地址；MCP Server 未启动时聊天自动降级为普通对话
export MCP_SERVER_URL="http://localhost:8081/mcp"

# ---------- MQTT（可选，默认匿名连接）----------
export MQTT_BROKER="tcp://127.0.0.1:1883"
export MQTT_USERNAME=""
export MQTT_PASSWORD=""

# ---------- 运行模式（可选）----------
# release 会关闭 SQL 日志等非必要输出
# export GIN_MODE=release
