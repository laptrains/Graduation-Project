# 复制为 config/config.toml 后按本机环境修改

[mainConfig]
appName = "GopherAI"
host = "0.0.0.0"
port = 9090

[emailConfig]
authcode = "your authcode "
email = "your qq email"

[redisConfig]
host = "127.0.0.1"
port = 6380 # docker compose 映射端口
password = ""
db = 0

[mysqlConfig]
host = "127.0.0.1"
port = 3307 # docker compose 映射端口
user = "root"
password = "your mysql password" # 改为自己的 MySQL 密码
databaseName = "Gopheral"
charset =  "utf8mb4"


# 会话记忆（开发测试用小阈值，上线前调大，如 40/16/80/800/24000）
[memoryConfig]
digestThreshold   = 6      # 窗口消息数超过该值触发摘要（≈3 轮）
keepRecent        = 2      # 摘要后保留的原文消息数（≈1 轮）
windowHardLimit   = 12     # 摘要失败时注入/加载的最大消息数兜底
digestMaxChars    = 300    # 摘要最大字符数
contextMaxChars   = 8000   # 单次注入上下文总字符上限
summarizeTimeoutS = 60     # 摘要调用超时（秒）

# 用户长期记忆（L3，跨会话）。提取复用 DEEPSEEK_API_KEY，未配置时只注入已有记忆、不再提取
userMemoryEnabled       = true
extractThreshold        = 4      # 未提取消息数达到该值触发提取（开发用小值，生产建议 6）
extractBatch            = 20     # 单次提取最多处理的消息数
userMemoryMaxEntries    = 30     # 最大条目数，满了拒绝新增、不淘汰旧条目
userMemoryEntryMaxChars = 100    # 单条最大字数
userMemoryMaxChars      = 1000   # 总字数上限
